# .env.example - copy to .env and adjust before running `docker compose up --build`

# --- General ---
# dev or prod. In prod, API docs (/docs, /redoc) are disabled.
ENV=dev

# Caddy site address. Use a real domain in prod (e.g. example.cz), or ":80"
# for plain HTTP dev / when running behind an external TLS terminator (e.g. Cloudflare).
DOMAIN=:80

# Full public base URL, used when building absolute links (e.g. in emails).
BASE_URL=http://localhost

# Secret used to sign/hash session and login tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Database ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# --- Access control ---
# Any syntactically valid email address may log in.
# Comma-separated emails that become role=admin on first login.
ADMIN_EMAILS=
# Comma-separated emails that become role=super_admin on first login.
SUPER_ADMIN_EMAILS=

# --- Contact / legal ---
CONTACT_EMAIL=

# --- SMTP (used for login codes/links) ---
# Seznam SMTP
SMTP_HOST=smtp.seznam.cz
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Optional Cloudflare Turnstile challenge, shown after repeated login attempts.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
LOGIN_CAPTCHA_THRESHOLD=3
LOGIN_RATE_LIMIT=20
LOGIN_EMAIL_RATE_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_COOLDOWN_SECONDS=900

# --- Storage ---
UPLOAD_DIR=/data/uploads
MAX_IMAGE_MB=8
MAX_RESOURCE_MB=25

# --- Moderation ---
AUTO_HIDE_REPORT_THRESHOLD=3
QUOTES_REQUIRE_APPROVAL=true

# --- Container memory limits (override defaults for larger/smaller machines) ---
DB_MEM_LIMIT=300m
WEB_MEM_LIMIT=350m
CADDY_MEM_LIMIT=60m
BACKUP_MEM_LIMIT=50m